{
  "manifest_version": 3,
  "name": "TIS Page Saver",
  "version": "1.3",
  "description": "One-click save the current Toyota TIS manual page as a self-contained offline HTML (images inlined).",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://techinfo.toyota.com/*"
  ],
  "action": {
    "default_title": "Save this TIS page for offline use"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}